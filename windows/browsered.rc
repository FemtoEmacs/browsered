// Icon and version information for browsered.exe.
#include <winver.h>

#ifndef VERSION_NUMBER
#define VERSION_NUMBER 0,1,0,0
#endif
#ifndef VERSION_STRING
#define VERSION_STRING "0.1.0"
#endif

1 ICON "browsered.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VERSION_NUMBER
PRODUCTVERSION VERSION_NUMBER
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "FemtoEmacs"
      VALUE "FileDescription", "Browsered helper"
      VALUE "FileVersion", VERSION_STRING
      VALUE "InternalName", "browsered"
      VALUE "OriginalFilename", "browsered.exe"
      VALUE "ProductName", "Browsered"
      VALUE "ProductVersion", VERSION_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
