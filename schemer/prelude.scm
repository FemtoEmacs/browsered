;;; Characters and strings, case
(define (char-upper-case? c) (let ((n (char->integer c))) (and (>= n 65) (<= n 90))))
(define (char-lower-case? c) (let ((n (char->integer c))) (and (>= n 97) (<= n 122))))
(define (char-foldcase c) (char-downcase c))
(define (digit-value c) (and (char-numeric? c) (- (char->integer c) 48)))
(define (char-ci=? a b) (char=? (char-downcase a) (char-downcase b)))
(define (char-ci<? a b) (char<? (char-downcase a) (char-downcase b)))
(define (char-ci>? a b) (char>? (char-downcase a) (char-downcase b)))
(define (char-ci<=? a b) (char<=? (char-downcase a) (char-downcase b)))
(define (char-ci>=? a b) (char>=? (char-downcase a) (char-downcase b)))
(define (string-map f s . ss)
  (if (null? ss)
      (let* ((n (string-length s)) (r (%make-string n #\space)))
        (let loop ((i 0)) (if (< i n) (begin (string-set! r i (f (string-ref s i))) (loop (+ i 1)))))
        r)
      (list->string (apply map f (string->list s) (map string->list ss)))))
(define (string-for-each f s . ss)
  (if (null? ss)
      (let loop ((i 0)) (if (< i (string-length s)) (begin (f (string-ref s i)) (loop (+ i 1)))))
      (apply for-each f (string->list s) (map string->list ss))))
(define (string-upcase s) (string-map char-upcase s))
(define (string-downcase s) (string-map char-downcase s))
(define (string-foldcase s) (string-map char-downcase s))
(define (string>? a b) (string<? b a))
(define (string<=? a b) (not (string<? b a)))
(define (string>=? a b) (not (string<? a b)))
(define (string-ci=? a b) (string=? (string-downcase a) (string-downcase b)))
(define (string-ci<? a b) (string<? (string-downcase a) (string-downcase b)))
(define (string-ci>? a b) (string<? (string-downcase b) (string-downcase a)))
(define (string-ci<=? a b) (not (string-ci<? b a)))
(define (string-ci>=? a b) (not (string-ci<? a b)))
(define (string-fill! s c . range)
  (let ((start (if (null? range) 0 (car range)))
        (end (if (or (null? range) (null? (cdr range))) (string-length s) (cadr range))))
    (let loop ((i start)) (if (< i end) (begin (string-set! s i c) (loop (+ i 1)))))))
(define (string->vector s . range) (list->vector (string->list (apply string-copy s range))))
(define (vector->string v . range) (list->string (vector->list (apply vector-copy v range))))

;;; Bytevectors: records holding a vector of small integers
(define %bytevector-type (cons (quote bytevector) (quote ())))   ; cons: ready before the library
(define (bytevector? x) (%record-of? x %bytevector-type))
(define (%bv v) (%make-record %bytevector-type (vector v)))
(define (%bytes b) (vector-ref (%record-fields b) 0))
(define (make-bytevector n . fill) (%bv (make-vector n (if (null? fill) 0 (car fill)))))
(define (bytevector . bytes) (%bv (list->vector bytes)))
(define (bytevector-length b) (vector-length (%bytes b)))
(define (bytevector-u8-ref b k) (vector-ref (%bytes b) k))
(define (bytevector-u8-set! b k v) (vector-set! (%bytes b) k v))
(define (bytevector-copy b . range) (%bv (apply vector-copy (%bytes b) range)))
(define (bytevector-copy! to at from . range) (apply vector-copy! (%bytes to) at (%bytes from) range))
(define (bytevector-append . bs) (%bv (apply vector-append (map %bytes bs))))
(define (string->utf8 s . range)
  (let ((out '()))
    (string-for-each
     (lambda (c)
       (let ((n (char->integer c)))
         (set! out
               (cond ((< n #x80) (cons n out))
                     ((< n #x800) (cons (+ #x80 (modulo n 64)) (cons (+ #xc0 (quotient n 64)) out)))
                     ((< n #x10000) (cons (+ #x80 (modulo n 64)) (cons (+ #x80 (modulo (quotient n 64) 64))
                                                                       (cons (+ #xe0 (quotient n 4096)) out))))
                     (else (cons (+ #x80 (modulo n 64)) (cons (+ #x80 (modulo (quotient n 64) 64))
                                                              (cons (+ #x80 (modulo (quotient n 4096) 64))
                                                                    (cons (+ #xf0 (quotient n 262144)) out)))))))))
     (apply string-copy s range))
    (%bv (list->vector (reverse out)))))
(define (utf8->string b . range)
  (let* ((v (%bytes b))
         (start (if (null? range) 0 (car range)))
         (end (if (or (null? range) (null? (cdr range))) (vector-length v) (cadr range))))
    (let loop ((i start) (cs '()))
      (if (>= i end) (list->string (reverse cs))
          (let* ((b0 (vector-ref v i))
                 (n (cond ((< b0 #x80) 1) ((< b0 #xe0) 2) ((< b0 #xf0) 3) (else 4)))
                 (code (let more ((k 1) (c (cond ((= n 1) b0) ((= n 2) (- b0 #xc0)) ((= n 3) (- b0 #xe0)) (else (- b0 #xf0)))))
                         (if (= k n) c (more (+ k 1) (+ (* c 64) (- (vector-ref v (+ i k)) #x80)))))))
            (loop (+ i n) (cons (integer->char code) cs)))))))

;;; Characters -----------------------------------------------------------------

(define (char=? a b) (= (char->integer a) (char->integer b)))
(define (char<? a b) (< (char->integer a) (char->integer b)))
(define (char>? a b) (> (char->integer a) (char->integer b)))
(define (char<=? a b) (<= (char->integer a) (char->integer b)))
(define (char>=? a b) (>= (char->integer a) (char->integer b)))
(define (char-alphabetic? c)
  (let ((n (char->integer c))) (or (and (>= n 65) (<= n 90)) (and (>= n 97) (<= n 122)) (> n 191))))
