;;;; prelude.scm -- Schemer's library, in Scheme
;;;;
;;;; Compiled with each program; only the definitions the program reaches
;;;; are kept.  Inside, (car x), (+ a b) ... with the right number of
;;;; arguments are written inline by the compiler; the definitions below
;;;; give the same names as procedures, for (map car l) and the like.

;;; Errors -----------------------------------------------------------------

(define (%type-error code obj)
  (error (cond ((= code 1) "not a number:")
               ((= code 2) "not a small integer:")
               ((= code 3) "division by zero:")
               ((= code 4) "too many arguments to")
               ((= code 5) "not a procedure:")
               ((= code 6) "wrong number of arguments to")
               (else "wrong type:"))
         obj))

;;; Records ------------------------------------------------------------------
;;; A record is a struct of its type and a vector of its fields; a record
;;; type is a pair (name . field-names), unique.

(define (%make-record-type name fields) (cons name fields))
(define (%record-of? x type) (and (%record? x) (eq? (%record-tag x) type)))
(define (%record-error obj who) (error "wrong type of argument to" who obj))

;;; Escapes, exceptions -----------------------------------------------------
;;; (%catch thunk tag), (%throw tag value), (%protect thunk after): the host
;;; does them with its own exceptions.  Continuations escape only: one
;;; called after its procedure returned is an error.

(define (call-with-current-continuation f)
  (let ((tag (cons (quote continuation) (quote ()))))
    (%catch (lambda ()
              (f (lambda vals
                   (%throw tag (if (and (pair? vals) (null? (cdr vals))) (car vals) (apply values vals))))))
            tag)))
(define (call/cc f) (call-with-current-continuation f))
(define (dynamic-wind before thunk after)
  (before)
  (%protect thunk after))

(define %handlers (quote ()))
(define (with-exception-handler handler thunk)
  (let ((saved %handlers))
    (set! %handlers (cons handler saved))
    (%protect thunk (lambda () (set! %handlers saved)))))
(define (raise-continuable obj)
  (if (null? %handlers)
      (%uncaught obj)
      (let ((saved %handlers))
        (set! %handlers (cdr saved))
        (let ((v ((car saved) obj)))
          (set! %handlers saved)
          v))))
(define (raise obj)
  (raise-continuable obj)
  (set! %handlers (quote ()))
  (error "an exception handler returned from raise:" obj))

(define %error-type (cons (quote error) (quote (message irritants kind))))   ; cons: ready before the library
(define (error msg . irritants)
  (raise (%make-record %error-type (vector msg irritants #f))))
(define (error-object? x) (%record-of? x %error-type))
(define (error-object-message e) (vector-ref (%record-fields e) 0))
(define (error-object-irritants e) (vector-ref (%record-fields e) 1))
(define (read-error? x) #f)
(define (file-error? x) (and (error-object? x) (eq? (vector-ref (%record-fields x) 2) (quote file))))
(define (%uncaught obj)
  (set! %out #f)   ; the message goes to the page, even from inside a string port
  (display "Error: ")
  (if (error-object? obj)
      (begin (display (error-object-message obj))
             (for-each (lambda (o) (write-char #\space) (write o)) (error-object-irritants obj)))
      (begin (display "uncaught exception: ") (write obj)))
  (newline)
  (%abort obj))
(define (exit . code) (%abort #f))
(define (emergency-exit . code) (%abort #f))

;;; The editor's procedures (link.scm, *editor-procedures*): the call goes
;;; to the editor as text, (name argument ...), written; the editor answers
;;; "ok VALUE" (VALUE written) or "error MESSAGE".  Arguments and values
;;; are data: numbers, strings, symbols, lists...; not procedures.
(define (%editor-apply name args)
  (let* ((reply (%editor (with-output-to-string (lambda () (write (cons name args))))))
         (n (string-length reply)))
    (cond ((and (>= n 3) (string=? (substring reply 0 3) "ok "))
           (let ((text (substring reply 3 n)))
             (if (and (> (string-length text) 1) (string=? (substring text 0 2) "#<"))
                 (%unspecified)   ; #<void>, #<buffer...>: not data
                 (guard (e (#t text))
                   (let ((v (read (open-input-string text)))) (if (eof-object? v) (%unspecified) v))))))
          (else (error (string-append "the editor's " (symbol->string name) ": "
                                      (if (> n 6) (substring reply 6 n) reply)))))))

;;; Parameters: (p) is the value; (p %param-set v) changes it
(define %param-set (cons (quote set) (quote ())))
(define %param-convert (cons (quote convert) (quote ())))
(define (make-parameter value . converter)
  (let* ((convert (if (null? converter) (lambda (x) x) (car converter)))
         (v (convert value)))
    (lambda args
      (cond ((null? args) v)
            ((eq? (car args) %param-set) (set! v (cadr args)))
            ((eq? (car args) %param-convert) (convert (cadr args)))
            (else (set! v (car args)))))))
(define (%parameterize params values thunk)
  (let ((new (map (lambda (p v) (p %param-convert v)) params values))
        (old (map (lambda (p) (p)) params)))
    (dynamic-wind
     (lambda () (for-each (lambda (p v) (p %param-set v)) params new))
     thunk
     (lambda () (for-each (lambda (p v) (p %param-set v)) params old)))))

;;; Procedures for the inline primitives ----------------------------------

(define (car x) (car x))
(define (cdr x) (cdr x))
(define (cons a b) (cons a b))
(define (set-car! p v) (set-car! p v))
(define (set-cdr! p v) (set-cdr! p v))
(define (null? x) (null? x))
(define (pair? x) (pair? x))
(define (eq? a b) (eq? a b))
(define (not x) (not x))
(define (boolean? x) (boolean? x))
(define (symbol? x) (symbol? x))
(define (string? x) (string? x))
(define (char? x) (char? x))
(define (vector? x) (vector? x))
(define (procedure? x) (procedure? x))
(define (vector-ref v k) (vector-ref v k))
(define (vector-set! v k x) (vector-set! v k x))
(define (vector-length v) (vector-length v))
(define (string-length s) (string-length s))
(define (string-ref s k) (string-ref s k))
(define (string-set! s k c) (string-set! s k c))
(define (char->integer c) (char->integer c))
(define (integer->char n) (integer->char n))
(define (zero? x) (zero? x))
(define (quotient a b) (quotient a b))
(define (remainder a b) (remainder a b))
(define (modulo a b) (modulo a b))
(define (caar x) (caar x)) (define (cadr x) (cadr x)) (define (cdar x) (cdar x))
(define (cddr x) (cddr x)) (define (caddr x) (caddr x)) (define (cdddr x) (cdddr x))
(define (cadddr x) (cadddr x))

;;; Numbers ------------------------------------------------------------------

(define (+ . xs) (let loop ((acc 0) (l xs)) (if (null? l) acc (loop (+ acc (car l)) (cdr l)))))
(define (* . xs) (let loop ((acc 1) (l xs)) (if (null? l) acc (loop (* acc (car l)) (cdr l)))))
(define (- x . ys)
  (if (null? ys) (- 0 x)
      (let loop ((acc x) (l ys)) (if (null? l) acc (loop (- acc (car l)) (cdr l))))))
(define (/ x . ys)
  (if (null? ys) (%num-div 1 x)
      (let loop ((acc x) (l ys)) (if (null? l) acc (loop (%num-div acc (car l)) (cdr l))))))
(define (%chain ok? a b rest)
  (if (ok? a b) (if (null? rest) #t (%chain ok? b (car rest) (cdr rest))) #f))
(define (< a b . r) (if (null? r) (< a b) (%chain (lambda (x y) (< x y)) a b r)))
(define (> a b . r) (if (null? r) (> a b) (%chain (lambda (x y) (> x y)) a b r)))
(define (<= a b . r) (if (null? r) (<= a b) (%chain (lambda (x y) (<= x y)) a b r)))
(define (>= a b . r) (if (null? r) (>= a b) (%chain (lambda (x y) (>= x y)) a b r)))
(define (= a b . r) (if (null? r) (= a b) (%chain (lambda (x y) (= x y)) a b r)))
(define (number? x) (or (fixnum? x) (%int? x) (flonum? x)))
(define (integer? x) (or (fixnum? x) (%int? x) (and (flonum? x) (= x (%flonum-floor x)))))
(define (rational? x) (number? x))
(define (real? x) (number? x))
(define (exact? x) (or (fixnum? x) (%int? x)))
(define (inexact? x) (flonum? x))
(define (exact-integer? x) (or (fixnum? x) (%int? x)))
(define (exact->inexact x) (%to-flonum x))
(define (inexact x) (%to-flonum x))
(define (inexact->exact x) (if (exact? x) x (%flonum->fixnum x)))
(define (exact x) (inexact->exact x))
(define (positive? x) (> x 0))
(define (negative? x) (< x 0))
(define (odd? n) (not (= (remainder n 2) 0)))
(define (even? n) (= (remainder n 2) 0))
(define (abs x) (if (< x 0) (- 0 x) x))
(define (max x . r) (let loop ((m x) (l r)) (if (null? l) m (loop (if (> (car l) m) (car l) m) (cdr l)))))
(define (min x . r) (let loop ((m x) (l r)) (if (null? l) m (loop (if (< (car l) m) (car l) m) (cdr l)))))
(define (floor x) (if (exact? x) x (%flonum-floor x)))
(define (ceiling x) (if (exact? x) x (- 0 (%flonum-floor (- 0 x)))))
(define (truncate x) (if (< x 0) (ceiling x) (floor x)))
(define (round x)
  (if (exact? x) x
      (let* ((f (floor x)) (d (- x f)))
        (cond ((< d 0.5) f) ((> d 0.5) (+ f 1))
              ((even? (inexact->exact f)) f) (else (+ f 1))))))
(define (sqrt x)
  ;; exact for the square of an integer
  (let ((r (%flonum-sqrt x)))
    (if (and (exact? x) (>= x 0) (= r (%flonum-floor r)) (< r 1e15)
             (let ((k (%flonum->fixnum r))) (= (* k k) x)))
        (%flonum->fixnum r)
        r)))
(define (exp x) (%math 0 x))
(define (log x . base) (if (null? base) (%math 1 x) (/ (%math 1 x) (%math 1 (car base)))))
(define (sin x) (%math 2 x))
(define (cos x) (%math 3 x))
(define (tan x) (%math 4 x))
(define (atan y . x) (if (null? x) (%math 5 y) (%math2 1 y (car x))))
(define (expt b e)
  (if (and (fixnum? e) (>= e 0) (fixnum? b))
      (let loop ((acc 1) (b b) (e e))
        (cond ((= e 0) acc)
              ((odd? e) (loop (* acc b) (* b b) (quotient e 2)))
              (else (loop acc (* b b) (quotient e 2)))))
      (%math2 0 b e)))
(define (square x) (* x x))
(define (gcd a b) (if (= b 0) (abs a) (gcd b (remainder a b))))
(define (lcm a b) (if (or (= a 0) (= b 0)) 0 (abs (quotient (* a b) (gcd a b)))))

(define (number->string n . radix)
  (let ((r (if (null? radix) 10 (car radix))))
    (cond ((flonum? n) (%flonum->string n))
          ((= n 0) "0")
          (else (let loop ((m (if (< n 0) n (- n))) (digits '()))
                  (if (= m 0)
                      (list->string (if (< n 0) (cons #\- digits) digits))
                      (loop (quotient m r)
                            (cons (string-ref "0123456789abcdefghijklmnopqrstuvwxyz" (- (remainder m r))) digits))))))))

;;; The host writes the flonum (shortest form that reads back the same);
;;; (%flonum-char x i) is its character i, or -1 past the end.
(define (%flonum->string x)
  (let loop ((i 0) (cs '()))
    (let ((c (%flonum-char x i)))
      (if (< c 0)
          (list->string (reverse cs))
          (loop (+ i 1) (cons (integer->char c) cs))))))

(define (%fixnum->string n)
  (if (= n 0) "0"
      (let loop ((m (if (< n 0) n (- n))) (digits '()))
        (if (= m 0)
            (list->string (if (< n 0) (cons #\- digits) digits))
            (loop (quotient m 10) (cons (integer->char (- 48 (remainder m 10))) digits))))))

(define (string->number s . radix)
  ;; prefixes #x #b #o #d #e #i, then an integer, a ratio or a decimal
  (let loop ((i 0) (r (if (null? radix) 10 (car radix))) (exactness #f))
    (if (and (< (+ i 1) (string-length s)) (char=? (string-ref s i) #\#))
        (case (char-downcase (string-ref s (+ i 1)))
          ((#\x) (loop (+ i 2) 16 exactness)) ((#\b) (loop (+ i 2) 2 exactness))
          ((#\o) (loop (+ i 2) 8 exactness)) ((#\d) (loop (+ i 2) 10 exactness))
          ((#\e) (loop (+ i 2) r (quote exact))) ((#\i) (loop (+ i 2) r (quote inexact)))
          (else #f))
        (let ((v (%parse-real (if (= i 0) s (substring s i (string-length s))) r)))
          (and v (case exactness
                   ((exact) (inexact->exact v))
                   ((inexact) (exact->inexact v))
                   (else v)))))))
(define (%parse-integer s r)
  (let* ((n (string-length s)) (negative (and (> n 0) (char=? (string-ref s 0) #\-))))
    (let loop ((i (if (and (> n 0) (memv (string-ref s 0) '(#\- #\+))) 1 0)) (acc 0) (any #f))
      (if (= i n)
          (and any acc)
          (let* ((c (string-ref s i))
                 (d (cond ((char-numeric? c) (- (char->integer c) 48))
                          ((char-alphabetic? c) (+ 10 (- (char->integer (char-downcase c)) 97)))
                          (else 99))))
            (and (< d r) (loop (+ i 1) (if negative (- (* acc r) d) (+ (* acc r) d)) #t)))))))
(define (%parse-real s r)
  (or (%parse-integer s r)
      (let ((k (let find ((i 0)) (cond ((= i (string-length s)) #f) ((char=? (string-ref s i) #\/) i) (else (find (+ i 1)))))))
        (and k
             (let ((a (%parse-integer (substring s 0 k) r))
                   (b (%parse-integer (substring s (+ k 1) (string-length s)) r)))
               (and a b (> (string-length s) (+ k 1)) (not (memv (string-ref s (+ k 1)) '(#\+ #\-)))
                    (not (= b 0)) (/ a b)))))
      (cond ((string=? s "+inf.0") (/ 1.0 0)) ((string=? s "-inf.0") (/ -1.0 0))
            ((or (string=? s "+nan.0") (string=? s "-nan.0")) (- (/ 1.0 0) (/ 1.0 0)))
            (else #f))
      (and (= r 10) (%decimal? s)
           (begin (string-for-each %number-char s) (%number-end)))))
;;; sign, digits, point, digits (one digit at least), exponent
(define (%decimal? s)
  (let ((n (string-length s)))
    (define (digits i) (let loop ((i i)) (if (and (< i n) (char-numeric? (string-ref s i))) (loop (+ i 1)) i)))
    (let* ((i (if (and (> n 0) (memv (string-ref s 0) '(#\+ #\-))) 1 0))
           (j (digits i))
           (k (if (and (< j n) (char=? (string-ref s j) #\.)) (digits (+ j 1)) j)))
      (and (> (- k i) (if (> k j) 1 0))
           (or (= k n)
               (and (memv (string-ref s k) '(#\e #\E))
                    (let* ((e (if (and (< (+ k 1) n) (memv (string-ref s (+ k 1)) '(#\+ #\-))) (+ k 2) (+ k 1)))
                           (f (digits e)))
                      (and (> f e) (= f n)))))))))
(define (%number-char c) (%number-char c))

;;; Multiple values: one value is itself; others are a record
(define %values-type (cons (quote values) (quote ())))   ; cons: a primitive, ready before the library
(define (values . xs)
  (if (and (pair? xs) (null? (cdr xs))) (car xs) (%make-record %values-type (vector xs))))
(define (call-with-values producer consumer)
  (let ((v (producer)))
    (if (%record-of? v %values-type)
        (apply consumer (vector-ref (%record-fields v) 0))
        (consumer v))))

;;; Hash tables ------------------------------------------------------------------
;;; A table is a record (kind count hash same?); the host keeps, for each
;;; table, a JavaScript Map (op 0 makes it).  eq and eqv tables map a key
;;; to (key . value); equal tables and tables with a hash function of
;;; their own map a hash to a list of (key . value).
;;;   ops: 0 new, 1 ref (v: default), 2 set, 3 delete, 4 size, 5 clear,
;;;        6 the list of the Map's values (v: the list's tail);
;;;        8, 9: ref and set in the host's table of symbols (by hash)

(define %table-type (cons (quote hashtable) (quote ())))   ; cons: ready before the library
(define (%new-table kind hash same?)
  (let ((t (%make-record %table-type (vector kind 0 hash same?))))
    (%table 0 t #f #f)
    t))
(define (hashtable? x) (%record-of? x %table-type))
(define (hash-table? x) (hashtable? x))
(define (%tf t i) (vector-ref (%record-fields t) i))

(define (make-eq-hashtable . size) (%new-table (quote eq) #f eq?))
(define (make-eqv-hashtable . size) (%new-table (quote eqv) #f eqv?))
(define (make-equal-hashtable . size) (%new-table (quote equal) equal-hash equal?))
(define (make-string-hashtable . size) (%new-table (quote equal) string-hash string=?))
(define (make-hashtable hash same? . size)
  (cond ((eq? same? eq?) (make-eq-hashtable))
        ((eq? same? eqv?) (make-eqv-hashtable))
        (else (%new-table (quote equal) hash same?))))
;;; SRFI 69: (make-hash-table [same? [hash]])
(define (make-hash-table . args)
  (let ((same? (if (pair? args) (car args) equal?)))
    (cond ((eq? same? eq?) (make-eq-hashtable))
          ((eq? same? eqv?) (make-eqv-hashtable))
          ((eq? same? equal?) (make-equal-hashtable))
          ((eq? same? string=?) (make-string-hashtable))
          (else (%new-table (quote equal) (if (and (pair? args) (pair? (cdr args))) (cadr args) equal-hash) same?)))))

;;; eqv: numbers and characters that are not unique objects become symbols
(define (%eqv-key k)
  (if (or (flonum? k) (%int? k) (and (char? k) (> (char->integer k) 255)))
      (string->symbol (string-append (if (char? k) "\x0;c" "\x0;n")
                                     (number->string (if (char? k) (char->integer k) k))))
      k))

;;; The (key . value) of K, or #f
(define (%table-entry t k)
  (case (%tf t 0)
    ((eq) (%table 1 t k #f))
    ((eqv) (%table 1 t (%eqv-key k) #f))
    (else (let ((same? (%tf t 3)))
            (let loop ((l (%table 1 t ((%tf t 2) k) (quote ()))))
              (cond ((null? l) #f) ((same? (caar l) k) (car l)) (else (loop (cdr l)))))))))

(define (hashtable-ref t k . default)
  (let ((e (%table-entry t k))) (if e (cdr e) (if (pair? default) (car default) #f))))
(define (hashtable-contains? t k) (if (%table-entry t k) #t #f))
(define (hashtable-set! t k v)
  (let ((e (%table-entry t k)))
    (if e (set-cdr! e v)
        (begin
          (vector-set! (%record-fields t) 1 (+ (%tf t 1) 1))
          (case (%tf t 0)
            ((eq) (%table 2 t k (cons k v)))
            ((eqv) (%table 2 t (%eqv-key k) (cons k v)))
            (else (let ((h ((%tf t 2) k)))
                    (%table 2 t h (cons (cons k v) (%table 1 t h (quote ())))))))))
    (%unspecified)))
(define (hashtable-delete! t k)
  (when (%table-entry t k)
    (vector-set! (%record-fields t) 1 (- (%tf t 1) 1))
    (case (%tf t 0)
      ((eq) (%table 3 t k #f))
      ((eqv) (%table 3 t (%eqv-key k) #f))
      (else (let* ((h ((%tf t 2) k)) (same? (%tf t 3))
                   (l (filter (lambda (e) (not (same? (car e) k))) (%table 1 t h (quote ())))))
              (if (null? l) (%table 3 t h #f) (%table 2 t h l))))))
  (%unspecified))
(define (hashtable-update! t k proc . default)
  (hashtable-set! t k (proc (if (pair? default) (hashtable-ref t k (car default))
                                (let ((e (%table-entry t k))) (if e (cdr e) (error "hashtable-update!: no such key" k)))))))
(define (hashtable-size t) (%tf t 1))
(define (hashtable-clear! t . size) (vector-set! (%record-fields t) 1 0) (%table 5 t #f #f) (%unspecified))
(define (%table-entries t)
  (let ((vs (%table 6 t #f (quote ()))))
    (if (memq (%tf t 0) (quote (eq eqv))) vs (apply append vs))))
(define (hashtable-keys t) (list->vector (map car (%table-entries t))))
(define (hashtable-values t) (list->vector (map cdr (%table-entries t))))
(define (hashtable-entries t)
  (let ((es (%table-entries t))) (values (list->vector (map car es)) (list->vector (map cdr es)))))
(define (hashtable->alist t) (map (lambda (e) (cons (car e) (cdr e))) (%table-entries t)))
(define (hashtable-copy t . mutable)
  (let ((new (%new-table (%tf t 0) (%tf t 2) (%tf t 3))))
    (for-each (lambda (e) (hashtable-set! new (car e) (cdr e))) (%table-entries t))
    new))
(define (hashtable-walk t proc) (for-each (lambda (e) (proc (car e) (cdr e))) (%table-entries t)))

;;; SRFI 69 names
(define (hash-table-ref t k . fail)
  (let ((e (%table-entry t k)))
    (cond (e (if (and (pair? fail) (pair? (cdr fail))) ((cadr fail) (cdr e)) (cdr e)))
          ((pair? fail) ((car fail)))
          (else (error "hash-table-ref: no such key" k)))))
(define (hash-table-ref/default t k d) (hashtable-ref t k d))
(define (hash-table-set! t k v) (hashtable-set! t k v))
(define (hash-table-delete! t k) (hashtable-delete! t k))
(define (hash-table-exists? t k) (hashtable-contains? t k))
(define (hash-table-contains? t k) (hashtable-contains? t k))
(define (hash-table-update! t k proc . fail)
  (hashtable-set! t k (proc (if (pair? fail) (hash-table-ref t k (car fail)) (hash-table-ref t k)))))
(define (hash-table-update!/default t k proc d) (hashtable-set! t k (proc (hashtable-ref t k d))))
(define (hash-table-count t) (hashtable-size t))
(define (hash-table-size t) (hashtable-size t))
(define (hash-table-keys t) (map car (%table-entries t)))
(define (hash-table-values t) (map cdr (%table-entries t)))
(define (hash-table->alist t) (hashtable->alist t))
(define (hash-table-walk t proc) (hashtable-walk t proc))
(define (hash-table-fold t kons knil)
  (let loop ((es (%table-entries t)) (acc knil))
    (if (null? es) acc (loop (cdr es) (kons (caar es) (cdar es) acc)))))
(define (hash-table-copy t . mutable) (hashtable-copy t))
(define (hash-table-clear! t) (hashtable-clear! t))
(define (alist->hash-table alist . args)
  (let ((t (apply make-hash-table args)))
    (for-each (lambda (e) (if (not (hashtable-contains? t (car e))) (hashtable-set! t (car e) (cdr e)))) alist)
    t))

;;; Hash functions
(define (string-hash s . bound)
  (let loop ((i 0) (h 5381))
    (if (= i (string-length s))
        (if (pair? bound) (modulo h (car bound)) h)
        (loop (+ i 1) (modulo (+ (* h 33) (char->integer (string-ref s i))) 16777213)))))
(define (string-ci-hash s . bound) (apply string-hash (string-downcase s) bound))
(define (symbol-hash s . bound) (apply string-hash (%symbol-name s) bound))
(define (equal-hash x . bound)
  (let ((h (%equal-hash x 32)))
    (if (pair? bound) (modulo h (car bound)) h)))
(define (hash x . bound) (apply equal-hash x bound))
;;; K: how many more parts of X to look at
(define (%equal-hash x k)
  (cond ((fixnum? x) (modulo x 16777213))
        ((string? x) (string-hash x))
        ((symbol? x) (string-hash (%symbol-name x)))
        ((char? x) (char->integer x))
        ((or (flonum? x) (%int? x)) (string-hash (number->string x)))
        ((<= k 0) 17)
        ((pair? x) (modulo (+ (* 31 (%equal-hash (car x) (quotient k 2))) (%equal-hash (cdr x) (- k 1))) 16777213))
        ((vector? x) (let loop ((i 0) (h (vector-length x)))
                       (if (or (= i (vector-length x)) (> i 8)) h
                           (loop (+ i 1) (modulo (+ (* 31 h) (%equal-hash (vector-ref x i) (quotient k 4))) 16777213)))))
        ((bytevector? x) (%equal-hash (%bytes x) k))
        ((eq? x #t) 1) ((eq? x #f) 2) ((null? x) 3)
        (else 23)))

;;; Equivalence ----------------------------------------------------------------

(define (eqv? a b) (%eqv? a b))
(define (equal? a b)
  ;; first a walk of at most 1000 parts; then, with union-find, a walk
  ;; that ends on shared and circular structures (Adams and Dybvig)
  (let ((r (%equal-fast a b 1000)))
    (cond ((not r) #f)
          ((>= r 0) #t)
          (else (%equal-slow a b (make-eq-hashtable))))))
;;; K: the parts left to look at; the result is the parts left, #f, or -1
(define (%equal-fast a b k)
  (cond ((%eqv? a b) k)
        ((<= k 0) -1)
        ((pair? a) (and (pair? b)
                        (let ((k2 (%equal-fast (car a) (car b) (- k 1))))
                          (if (and k2 (>= k2 0)) (%equal-fast (cdr a) (cdr b) k2) k2))))
        ((string? a) (and (string? b) (string=? a b) k))
        ((vector? a)
         (and (vector? b) (= (vector-length a) (vector-length b))
              (let loop ((i 0) (k k))
                (if (= i (vector-length a)) k
                    (let ((k2 (%equal-fast (vector-ref a i) (vector-ref b i) (- k 1))))
                      (if (and k2 (>= k2 0)) (loop (+ i 1) k2) k2))))))
        ((bytevector? a) (and (bytevector? b) (%equal-fast (%bytes a) (%bytes b) k)))
        (else #f)))
(define (%equal-slow a b uf)
  ;; the pairs of parts still to compare are a list, not the stack
  (let loop ((todo (list (cons a b))))
    (if (null? todo) #t
        (let ((a (caar todo)) (b (cdar todo)) (rest (cdr todo)))
          (cond ((%eqv? a b) (loop rest))
                ((pair? a) (and (pair? b)
                                (if (%union! uf a b) (loop rest)
                                    (loop (cons (cons (car a) (car b)) (cons (cons (cdr a) (cdr b)) rest))))))
                ((string? a) (and (string? b) (string=? a b) (loop rest)))
                ((vector? a)
                 (and (vector? b) (= (vector-length a) (vector-length b))
                      (if (%union! uf a b) (loop rest)
                          (loop (let add ((i (- (vector-length a) 1)) (rest rest))
                                  (if (< i 0) rest
                                      (add (- i 1) (cons (cons (vector-ref a i) (vector-ref b i)) rest))))))))
                ((bytevector? a) (and (bytevector? b) (equal? (%bytes a) (%bytes b)) (loop rest)))
                (else #f))))))
;;; #t when A and B were already in one class; else they are joined
(define (%union! uf a b)
  (let ((ra (%find uf a)) (rb (%find uf b)))
    (or (eq? ra rb)
        (begin (hashtable-set! uf ra rb) #f))))
(define (%find uf x)
  ;; the root, then every node on the way points to it
  (let ((root (let up ((x x)) (let ((p (hashtable-ref uf x #f))) (if p (up p) x)))))
    (let compress ((x x))
      (let ((p (hashtable-ref uf x #f)))
        (when (and p (not (eq? p root)))
          (hashtable-set! uf x root)
          (compress p))))
    root))

;;; Lists ------------------------------------------------------------------

(define (list . xs) xs)
(define (length l) (let loop ((l l) (n 0)) (if (pair? l) (loop (cdr l) (+ n 1)) n)))
(define (list? l) (cond ((null? l) #t) ((pair? l) (list? (cdr l))) (else #f)))   ; a tail call
;; Long lists are walked with loops, not recursion: the WebAssembly stack
;; is the browser's, about 9000 calls deep.
(define (%append2 a b) (%reverse-onto (reverse a) b))
(define (%reverse-onto r tail) (if (null? r) tail (%reverse-onto (cdr r) (cons (car r) tail))))
(define (append . ls)
  (cond ((null? ls) '())
        ((null? (cdr ls)) (car ls))
        (else (%append2 (car ls) (apply append (cdr ls))))))
(define (reverse l) (let loop ((l l) (acc '())) (if (null? l) acc (loop (cdr l) (cons (car l) acc)))))
(define (list-tail l k) (if (= k 0) l (list-tail (cdr l) (- k 1))))
(define (list-ref l k) (car (list-tail l k)))
(define (last-pair l) (if (pair? (cdr l)) (last-pair (cdr l)) l))
(define (memq x l) (cond ((null? l) #f) ((eq? x (car l)) l) (else (memq x (cdr l)))))
(define (memv x l) (cond ((null? l) #f) ((%eqv? x (car l)) l) (else (memv x (cdr l)))))
(define (member x l . same?)
  (if (null? same?)
      (let loop ((l l)) (cond ((null? l) #f) ((equal? x (car l)) l) (else (loop (cdr l)))))
      (let loop ((l l)) (cond ((null? l) #f) (((car same?) x (car l)) l) (else (loop (cdr l)))))))
(define (assq x l) (cond ((null? l) #f) ((eq? x (caar l)) (car l)) (else (assq x (cdr l)))))
(define (assv x l) (cond ((null? l) #f) ((%eqv? x (caar l)) (car l)) (else (assv x (cdr l)))))
(define (assoc x l . same?)
  (if (null? same?)
      (let loop ((l l)) (cond ((null? l) #f) ((equal? x (caar l)) (car l)) (else (loop (cdr l)))))
      (let loop ((l l)) (cond ((null? l) #f) (((car same?) x (caar l)) (car l)) (else (loop (cdr l)))))))
(define (%map1 f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (%cars ls) (if (null? ls) '() (cons (caar ls) (%cars (cdr ls)))))
(define (%cdrs ls) (if (null? ls) '() (cons (cdar ls) (%cdrs (cdr ls)))))
(define (%any-null? ls) (and (pair? ls) (or (null? (car ls)) (%any-null? (cdr ls)))))
(define (map f l . ls)
  (if (null? ls) (%map1 f l)
      (let loop ((ls (cons l ls)) (acc '()))
        (if (%any-null? ls) (reverse acc) (loop (%cdrs ls) (cons (apply f (%cars ls)) acc))))))
(define (for-each f l . ls)
  (if (null? ls)
      (let loop ((l l)) (if (pair? l) (begin (f (car l)) (loop (cdr l)))))
      (let loop ((ls (cons l ls)))
        (if (not (%any-null? ls)) (begin (apply f (%cars ls)) (loop (%cdrs ls))))))
  (%unspecified))
(define (filter p l) (let loop ((l l) (acc '())) (cond ((null? l) (reverse acc)) ((p (car l)) (loop (cdr l) (cons (car l) acc))) (else (loop (cdr l) acc)))))
(define (fold-left f acc l) (if (null? l) acc (fold-left f (f acc (car l)) (cdr l))))
(define (fold-right f acc l) (fold-left (lambda (a x) (f x a)) acc (reverse l)))
(define (iota n . start) (let loop ((i (- n 1)) (acc '()))
                           (if (< i 0) acc (loop (- i 1) (cons (+ i (if (null? start) 0 (car start))) acc)))))
(define (apply f . args)
  (%apply f (let spread ((a args)) (if (null? (cdr a)) (car a) (cons (car a) (spread (cdr a)))))))

;;; More of R7RS ----------------------------------------------------------------

(define (floor-quotient a b) (floor/ a b #t))
(define (floor-remainder a b) (modulo a b))
(define (floor/ a b . q-only)
  (let* ((q (quotient a b)) (r (- a (* q b))))
    (let ((q (if (and (not (= r 0)) (not (eq? (negative? r) (negative? b)))) (- q 1) q)))
      (if (null? q-only) (values q (- a (* q b))) q))))
(define (truncate-quotient a b) (quotient a b))
(define (truncate-remainder a b) (remainder a b))
(define (truncate/ a b) (values (quotient a b) (remainder a b)))
(define (exact-integer-sqrt n)
  (let loop ((x (if (< n 4) (if (= n 0) 0 1) (inexact->exact (floor (sqrt n))))))
    (cond ((> (* x x) n) (loop (- x 1)))
          ((<= (* (+ x 1) (+ x 1)) n) (loop (+ x 1)))
          (else (values x (- n (* x x)))))))
(define (numerator x) x)
(define (denominator x) (if (exact? x) 1 1.0))
(define (rationalize x y) x)
(define (complex? x) (number? x))
