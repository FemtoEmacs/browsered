;;; Strings ------------------------------------------------------------------

(define (make-string n . c) (%make-string n (if (null? c) #\space (car c))))
(define (string . cs) (list->string cs))
(define (list->string l)
  (let ((s (%make-string (length l) #\space)))
    (let loop ((i 0) (l l)) (if (pair? l) (begin (string-set! s i (car l)) (loop (+ i 1) (cdr l)))))
    s))
(define (string->list s)
  (let loop ((i (- (string-length s) 1)) (acc '()))
    (if (< i 0) acc (loop (- i 1) (cons (string-ref s i) acc)))))
;;; the copies are array.copy instructions
(define (substring s start . end)
  (let* ((e (if (null? end) (string-length s) (car end))) (r (%make-string (- e start) #\space)))
    (%string-copy! r 0 s start (- e start))
    r))
(define (string-copy s . range)
  (let ((start (if (null? range) 0 (car range))))
    (substring s start (if (or (null? range) (null? (cdr range))) (string-length s) (cadr range)))))
(define (string-copy! to at from . range)
  (let* ((start (if (null? range) 0 (car range)))
         (end (if (or (null? range) (null? (cdr range))) (string-length from) (cadr range))))
    (%string-copy! to at from start (- end start))))
(define (string-append . ss)
  (let* ((n (let loop ((l ss) (n 0)) (if (null? l) n (loop (cdr l) (+ n (string-length (car l)))))))
         (r (%make-string n #\space)))
    (let loop ((l ss) (k 0))
      (if (pair? l)
          (let ((s (car l)))
            (%string-copy! r k s 0 (string-length s))
            (loop (cdr l) (+ k (string-length s))))))
    r))
(define (string=? a b)
  (and (= (string-length a) (string-length b))
       (let loop ((i 0))
         (or (= i (string-length a))
             (and (char=? (string-ref a i) (string-ref b i)) (loop (+ i 1)))))))
(define (string<? a b)
  (let loop ((i 0))
    (cond ((= i (string-length a)) (< i (string-length b)))
          ((= i (string-length b)) #f)
          ((char<? (string-ref a i) (string-ref b i)) #t)
          ((char<? (string-ref b i) (string-ref a i)) #f)
          (else (loop (+ i 1))))))
(define (symbol->string s) (string-copy (%symbol-name s)))
(define (string->symbol s) (%intern! (%make-symbol (string-copy s))))
(define (%intern! sym)
  ;; the symbol of the same name already known, or SYM, now known
  (let* ((name (%symbol-name sym)) (h (string-hash name)) (bucket (%table 8 #f h (quote ()))))
    (let loop ((l bucket))
      (cond ((null? l) (%table 9 #f h (cons sym bucket)) sym)
            ((%name=? (%symbol-name (car l)) name) (car l))
            (else (loop (cdr l)))))))
(define (%name=? a b)
  (and (= (string-length a) (string-length b))
       (let loop ((i 0))
         (or (= i (string-length a))
             (and (= (char->integer (string-ref a i)) (char->integer (string-ref b i))) (loop (+ i 1)))))))
(define *gensym-count* 0)
(define (gensym) (set! *gensym-count* (+ *gensym-count* 1))
  (%make-symbol (string-append "g" (%fixnum->string *gensym-count*))))

